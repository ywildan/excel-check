# ============================================================
# Checker Sikarsa — environment variables
# Salin file ini menjadi .env.local untuk pengembangan lokal.
# Untuk production, isi nilainya di dashboard Vercel.
# Jangan commit file .env atau .env.local.
# ============================================================

# --- Auth.js (wajib) ---
# String acak panjang. Buat dengan: npx auth secret
AUTH_SECRET=""

# URL publik aplikasi.
# Lokal  : http://localhost:3000
# Produksi: https://checker.sikarsa.id
AUTH_URL="http://localhost:3000"

# --- Google OAuth (wajib untuk login) ---
# Google Cloud Console > APIs & Services > Credentials
# > Create credentials > OAuth client ID > Web application
#
# Authorized JavaScript origin:
#   http://localhost:3000
#   https://checker.sikarsa.id
#
# Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://checker.sikarsa.id/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Database Postgres (wajib untuk riwayat) ---
# Neon / Vercel Postgres / Postgres lain.
# Gunakan connection string dengan sslmode=require.
# Jika migrasi gagal dengan koneksi pooled, jalankan
# `npx prisma migrate deploy` memakai connection string direct.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
